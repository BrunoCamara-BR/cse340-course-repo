<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <!-- Put your page-specific content here -->
        <h2>Upcoming Service Projects</h2>
        <ul>
            <% projects.forEach( project=> {%>
                <li>
                    <%= project.date.toLocaleDateString("en-US", {
                        month: "short",
                        day: "numeric",
                        year: "numeric",
                        timeZone: "UTC"
                    } ) %>: 
                    <%= project.title %> ( <%= project.name  %> ) 
                </li>

                <% }); %>
        </ul>

    </main>
    <%- include('partials/footer') %>