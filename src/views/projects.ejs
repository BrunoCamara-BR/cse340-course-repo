<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <h2> The next five upcoming projects</h2>
        <ul>
            <% projects.forEach( project=> {%>
                <li>
                    <%= project.date.toLocaleDateString("en-US", { month: "short" , day: "numeric" , year: "numeric" ,
                        timeZone: "UTC" } ) %>:
                        (<a href="/organization/<%=project.organization_id%>">
                            <%= project.organization_name %>
                        </a> )
                        <a href="/project/<%=project.project_id%>">
                            <%= project.title %>
                        </a>
                </li>

                <% }); %>
        </ul>

    </main>
    <%- include('partials/footer') %>